{
  "expo": {
    "name": "RAID Browser",
    "slug": "raid-browser",
    "version": "2.10.1",
    "orientation": "portrait",
    "scheme": "raidbrowser",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.yosef.raidbrowser",
      "versionCode": 39,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#232625"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-sqlite",
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": true
        }
      ],
      "./plugins/withRaidWebViewSecurity",
      "./plugins/withRaidWireGuard",
      "./plugins/withRaidLauncherIcon"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
