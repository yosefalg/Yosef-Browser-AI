{
  "expo": {
    "name": "RAID Browser",
    "slug": "raid-browser",
    "version": "2.15.9",
    "orientation": "portrait",
    "scheme": "raidbrowser",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.yosef.raidbrowser",
      "versionCode": 195,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "http"
            },
            {
              "scheme": "https"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#071018"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-sqlite",
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": true
        }
      ],
      "./plugins/withRaidWebViewSecurity",
      "./plugins/withRaidWireGuard",
      "./plugins/withRaidLauncherIcon"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
